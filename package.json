{
    "name": "wn-erecht24-plugin",
    "version": "0.9.1.4",
    "description": "This plugin lets you retrieve legal texts through the eRecht24 API and use them on your website",
    "author": "Manuel Burghammer",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/xitara/wn-erecht24-plugin.git"
    },
    "scripts": {
        "install": "node ./scripts/setup.js && node ./scripts/composer.js",
        "prepare": "husky",
        "build": "node ./scripts/webpack-wrapper.js --mode production --progress",
        "dbuild": "node ./scripts/webpack-wrapper.js --mode development --progress",
        "watch": "cross-env TAILWIND_MODE=watch node ./scripts/webpack-wrapper.js --watch --mode production --progress",
        "dwatch": "cross-env TAILWIND_MODE=watch node ./scripts/webpack-wrapper.js --watch --mode development --progress",
        "build-all": "node ./scripts/build-all.js",
        "zip": "node ./scripts/pack.js",
        "upload": "node ./scripts/upload.js",
        "deploy": "node ./scripts/pack.js && node ./scripts/upload.js",
        "docs": "node ./scripts/phpdoc.js && node ./scripts/start-browser.js ./.docs/api/index.html",
        "analyze": "webpack-bundle-analyzer ./stats.json",
        "lint-js": "eslint 'src/js/**/*.js' --fix",
        "lint-ts": "eslint 'src/ts/**/*.ts' --fix",
        "lint-style": "stylelint 'src/scss/**/*.{css,scss}' --fix",
        "check-eslint-config": "eslint-config-prettier .eslint",
        "check-stylelint-config": "stylelint-config-prettier-check",
        "cleanup": "node ./scripts/cleanup.js",
        "ncu": "ncu -u",
        "start": "webpack-dev-server --open --mode development --progress"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
        "@babel/plugin-transform-async-to-generator": "^8.0.1",
        "@babel/plugin-transform-runtime": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/runtime": "^8.0.0",
        "@prettier/plugin-php": "^0.25.0",
        "@tailwindcss/postcss7-compat": "^2.2.17",
        "@types/jquery": "^4.0.1",
        "@types/node": "^26.1.2",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "autoprefixer": "^10.5.4",
        "babel-loader": "^10.1.1",
        "brotli-webpack-plugin": "^1.1.0",
        "compression-webpack-plugin": "^12.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "cssnano-webpack-plugin": "^1.0.3",
        "csso-webpack-plugin": "^3.0.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "extract-css-chunks-webpack-plugin": "^4.10.0",
        "file-loader": "^6.2.0",
        "glob": "^13.0.6",
        "globals": "^17.9.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "mini-css-extract-plugin": "^2.10.2",
        "normalize.css": "^8.0.1",
        "postcss": "^8.5.25",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-loader": "^8.2.1",
        "prettier": "^3.9.6",
        "purgecss-webpack-plugin": "^8.0.0",
        "rimraf": "^6.1.3",
        "sass": "^1.102.0",
        "sass-loader": "^17.0.0",
        "style-loader": "^4.0.0",
        "stylelint": "^17.14.1",
        "stylelint-cli": "^1.3.0",
        "stylelint-config-prettier": "^9.0.5",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-sass-guidelines": "^13.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-prettier": "^5.0.3",
        "stylelint-scss": "^7.2.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.5",
        "typescript": "^7.0.2",
        "webpack": "^5.109.2",
        "webpack-assets-manifest": "^6.5.2",
        "webpack-bundle-analyzer": "^5.3.1",
        "webpack-cli": "^7.2.2",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1",
        "webpack-stats-plugin": "1.1.3",
        "ws": "^8.21.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "yarn check-eslint-config && yarn lint-code && yarn check-stylelint-config && yarn lint-style"
        }
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix"
        ],
        "*.ts": [
            "eslint --fix"
        ],
        "*.{css,scss}": [
            "stylelint --fix"
        ]
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8",
        "glightbox": "^3.3.1",
        "global": "^4.4.0",
        "highlight.js": "^11.11.1",
        "mark.js": "^8.11.1",
        "micromodal": "^0.7.0",
        "npm-check-updates": "^23.0.1",
        "simplebar": "^6.3.3",
        "tailwindcss": "^4.3.3",
        "tiny-slider": "^2.9.4",
        "vanilla-lazyload": "^19.1.3"
    }
}
